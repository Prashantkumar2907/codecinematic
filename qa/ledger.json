  "systemic": [
    {
      "id": "frozen-3d-layer",
      "status": "fixed-centrally-2026-07-27",
      "detail": "render3D caches the ThreeBundle per key; painters wrote update() as a closure over env, capturing frame 0. Every scene starts at p=0, so the whole 3D layer was frozen/invisible in production. Fixed in three3d.ts via a liveEnv arg + Object.assign onto the captured env; all 29 call sites updated. VISUALLY VERIFIED ONLY FOR bigtext AND bullets - the other 27 now animate for the first time and must be re-reviewed as the wave reaches them.",
      "affected": [
        "bigtext",
        "bracket",
        "browserframe",
        "bullets",
        "callstack",
        "chain",
        "chart",
        "code",
        "compare",
        "cycle",
        "diagram",
        "formula",
        "geomap",
        "layers",
        "ledger",
        "lifeline",
        "matrix",
        "memgrid",
        "quote",
        "schematic",
        "showdown",
        "skyline",
        "stat",
        "statemachine",
        "storyboard",
        "table",
        "terminal",
        "timeline",
        "trace"
      ]
    },
    {
      "id": "three3d-cache-ignores-aspect",
      "status": "fixed-in-harness-2026-07-27",
      "detail": "Geometry is built once per key from the first rect it sees, so rendering short then long in one page reused the wrong build. Harmless in production (one aspect per video) but it corrupted QA. probe now calls resetThree3D() before every strip."
    },
    {
      "id": "hardcoded-world-size-vs-frustum",
      "status": "helper-added-2026-07-27",
      "detail": "Painters size three.js geometry with literals that only fit 16:9; the frustum half-width is halfH*aspect, so 9:16 is ~2.5x narrower and the geometry hangs off both edges. Hit bullets, stat and quote. three3d.ts now exports frustumHalfExtent(camera, rect) - use it instead of literals. npm run edge-audit measures which kinds still bleed."
    },
    {
      "id": "2d-layout-round-tripped-through-camera",
      "status": "open",
      "detail": "Painters that map 2D pixel positions linearly into world space and then project back through a TILTED perspective camera do not recover the source pixel - the ground plane maps non-linearly. Confirmed in showdown; suspected in race and any painter with a worldPos(px,py) helper plus an off-axis camera. Symptom: elements near the design edges land outside the frame, worst at 9:16 where the frustum is narrowest."
    }
  ],
  "tools": [
    {
      "name": "edge-audit",
      "cmd": "npm run edge-audit",
      "detail": "Renders every kind at both aspects, diffs a 3px border ring against the bare background, flags hard-contrast content at the frame edge. Writes qa/AUDIT.md. Measures rubric section 1 across all 110 kinds in ~4 min instead of reading 220 contact sheets."
    }
  ],
  "acceptedEdgeBleed": [
    "zoomladder"
  ]
}